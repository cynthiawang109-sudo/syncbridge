{
  "name": "syncbridge",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "generate": "prisma generate",
    "demo": "node scripts/demo.mjs",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "demo:recovery": "node scripts/demo-recovery.mjs",
    "demo:mvp-b": "node scripts/demo-mvp-b.mjs",
    "demo:hardening": "node scripts/demo-hardening.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1172.0",
    "@aws-sdk/lib-dynamodb": "^3.1172.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "6.19.0",
    "bullmq": "^5.0.0",
    "express": "^5.3.0",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "prisma": "6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "effect": "3.20.0"
  }
}
