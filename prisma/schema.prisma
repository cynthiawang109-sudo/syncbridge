generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Lifecycle {
  active
  closing
  deleted
}

enum TokenStatus {
  disconnected
  connected
  needs_reauth
  error
}

enum RunStatus {
  queued
  running
  succeeded
  partial
  failed
}

enum Mode {
  full
  incremental
}

enum ClaimState {
  pending
  claimed
  done
  failed
}

model Tenant {
  id          String       @id
  name        String
  deletedAt   DateTime?    @map("deleted_at")
  connections Connection[]

  @@map("tenants")
}

model Connection {
  id                   String              @id @default(uuid())
  tenantId             String              @map("tenant_id")
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  name                 String
  provider             String              @default("mock")
  lifecycle            Lifecycle           @default(active)
  generation           Int                 @default(0)
  tokenStatus          TokenStatus         @default(disconnected) @map("token_status")
  tokenError           String?             @map("token_error")
  encryptedTokens      String?             @map("encrypted_tokens")
  keyVersion           String?             @map("key_version")
  tokenExpiresAt       DateTime?           @map("token_expires_at")
  tokenVersion         Int                 @default(0) @map("token_version")
  scopes               String[]            @default([])
  refreshGeneration    Int                 @default(0) @map("refresh_generation")
  refreshLeaseUntil    DateTime?           @map("refresh_lease_until")
  oauthStateHash       String?             @unique @map("oauth_state_hash")
  oauthVerifier        String?             @map("oauth_verifier")
  oauthExpiresAt       DateTime?           @map("oauth_expires_at")
  watermark            Int                 @default(0)
  reconcileEmployeesAt DateTime            @default(dbgenerated("(CURRENT_TIMESTAMP + interval '1 hour')")) @map("reconcile_employees_at")
  reconcilePayrunsAt   DateTime            @default(dbgenerated("(CURRENT_TIMESTAMP + interval '1 hour')")) @map("reconcile_payruns_at")
  reconciliations      ReconciliationRun[]
  metrics              MetricBucket[]
  payrunWatermark      Int                 @default(0) @map("payrun_watermark")
  cleanupAt            DateTime?           @map("cleanup_at")
  pausedReason         String?             @map("paused_reason")
  failureStreak        Int                 @default(0) @map("failure_streak")
  rateStreak           Int                 @default(0) @map("rate_streak")
  rateUntil            DateTime?           @map("rate_until")
  records              ExternalRecord[]
  runs                 SyncRun[]

  @@index([tenantId])
  @@map("connections")
}

model ExternalRecord {
  connectionId String              @map("connection_id")
  connection   Connection          @relation(fields: [connectionId], references: [id])
  resourceType String              @map("resource_type")
  externalId   String              @map("external_id")
  version      Int
  payloadHash  String              @map("payload_hash")
  payload      Json
  tombstone    Boolean             @default(false)
  lastSyncedAt DateTime            @map("last_synced_at")
  outcomes     SyncRecordOutcome[]

  @@id([connectionId, resourceType, externalId])
  @@map("external_records")
}

model SyncRun {
  id           String              @id @default(uuid())
  connectionId String              @map("connection_id")
  connection   Connection          @relation(fields: [connectionId], references: [id])
  generation   Int
  resourceType String              @default("employees") @map("resource_type")
  mode         Mode
  status       RunStatus           @default(queued)
  cursor       String?
  snapshot     String?
  watermark    Int?
  since        Int
  page         Int                 @default(0)
  error        String?
  createdAt    DateTime            @default(now()) @map("created_at")
  outcomes     SyncRecordOutcome[]
  attempts     OperationAttempt[]

  @@map("sync_runs")
}

model SyncRecordOutcome {
  runId             String         @map("run_id")
  run               SyncRun        @relation(fields: [runId], references: [id])
  recordKey         String         @map("record_key")
  operationIdentity String         @map("operation_identity")
  connectionId      String         @map("connection_id")
  resourceType      String         @map("resource_type")
  record            ExternalRecord @relation(fields: [connectionId, resourceType, recordKey], references: [connectionId, resourceType, externalId])
  version           Int
  result            String
  conflictHash      String?        @map("conflict_hash")

  @@id([runId, recordKey, operationIdentity])
  @@map("sync_record_outcomes")
}

model OperationAttempt {
  key          String     @id
  runId        String?    @map("run_id")
  run          SyncRun?   @relation(fields: [runId], references: [id])
  attemptCount Int        @default(0) @map("attempt_count")
  dueAt        DateTime   @default(now()) @map("due_at")
  pausedAt     DateTime?  @map("paused_at")
  state        ClaimState @default(pending)
  claimToken   String?    @map("claim_token")
  leaseUntil   DateTime?  @map("lease_until")
  createdAt    DateTime   @default(now()) @map("created_at")

  connectionId      String?            @map("connection_id")
  generation        Int?
  eventId           String?            @map("event_id")
  evidence          Json?
  replayId          String?            @unique @map("replay_id")
  deadLetterId      String?            @map("dead_letter_id")
  reconciliationId  String?            @map("reconciliation_id")
  reconciliation    ReconciliationRun? @relation(fields: [reconciliationId], references: [id])
  repairRecordId    String?            @map("repair_record_id")
  projectionPending Boolean            @default(false) @map("projection_pending")

  @@index([connectionId, state])
  @@index([state, dueAt])
  @@map("operation_attempt")
}

model AuthorizationAudit {
  id        String   @id @default(uuid())
  actor     String
  object    String
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("authorization_audit")
}

enum ReplayState {
  open
  replay_queued
  resolved
  reopened
}

model DeadLetter {
  id            String        @id @default(uuid())
  connectionId  String        @map("connection_id")
  tenantId      String        @map("tenant_id")
  operationKey  String        @map("operation_key")
  eventId       String?       @map("event_id")
  runId         String?       @map("run_id")
  reason        String
  payload       Json
  providerError Json?         @map("provider_error")
  state         ReplayState   @default(open)
  createdAt     DateTime      @default(now()) @map("created_at")
  audits        ReplayAudit[]

  @@unique([connectionId, operationKey])
  @@index([tenantId, connectionId])
  @@map("dead_letters")
}

model AttemptHistory {
  operationKey  String   @map("operation_key")
  attempt       Int
  result        String
  providerError Json?    @map("provider_error")
  recordedAt    DateTime @default(now()) @map("recorded_at")

  @@id([operationKey, attempt])
  @@map("attempt_history")
}

model ReplayAudit {
  id            String     @id @default(uuid())
  deadLetterId  String     @map("dead_letter_id")
  deadLetter    DeadLetter @relation(fields: [deadLetterId], references: [id], onDelete: Cascade)
  actor         String
  result        String
  archiveAbsent Boolean?   @map("archive_absent")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([deadLetterId])
  @@map("replay_audit")
}

model WebhookOutcome {
  operationKey   String  @id @map("operation_key")
  connectionId   String  @map("connection_id")
  eventId        String  @map("event_id")
  eventVersion   Int     @map("event_version")
  fetchedVersion Int?    @map("fetched_version")
  result         String
  conflictHash   String? @map("conflict_hash")

  @@index([connectionId, eventId])
  @@map("webhook_outcomes")
}

model ReconciliationRun {
  id           String                      @id @default(uuid())
  connectionId String                      @map("connection_id")
  connection   Connection                  @relation(fields: [connectionId], references: [id])
  resourceType String                      @map("resource_type")
  generation   Int
  trigger      String
  status       String                      @default("traversing")
  reason       String?
  page         Int                         @default(0)
  cursor       String?
  snapshot     String?
  watermark    Int?
  createdAt    DateTime                    @default(now()) @map("created_at")
  finishedAt   DateTime?                   @map("finished_at")
  findings     ReconciliationFinding[]
  observations ReconciliationObservation[]
  attempts     OperationAttempt[]

  @@index([connectionId, resourceType, createdAt])
  @@map("reconciliation_runs")
}

model ReconciliationFinding {
  runId           String            @map("run_id")
  run             ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  externalId      String            @map("external_id")
  classification  String
  confidence      String
  mirrorVersion   Int?              @map("mirror_version")
  providerVersion Int?              @map("provider_version")
  repairStatus    String            @default("none") @map("repair_status")
  repairResult    String?           @map("repair_result")

  @@id([runId, externalId])
  @@map("reconciliation_findings")
}

model ReconciliationObservation {
  runId      String            @map("run_id")
  run        ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  externalId String            @map("external_id")
  version    Int
  hash       String
  evidence   Json

  @@id([runId, externalId])
  @@map("reconciliation_observations")
}

model MetricBucket {
  connectionId String     @map("connection_id")
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  minute       DateTime
  kind         String
  samples      Int        @default(0)
  total        Float      @default(0)
  peak         Float      @default(0)

  @@id([connectionId, minute, kind])
  @@index([minute])
  @@map("metric_buckets")
}
